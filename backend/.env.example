# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
# Individual connection parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_project_manager
DB_USER=postgres
DB_PASSWORD=postgres

# Alternatively, specify a full connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_project_manager

# ---------------------------------------------------------------------------
# Accounts, sessions and encryption
# ---------------------------------------------------------------------------
# 32 byte key (64 hex characters or base64) used to encrypt the per-user
# GitHub tokens with AES-256-GCM. If it is missing the server generates one
# and stores it in backend/.env with 0600 permissions.
ENCRYPTION_KEY=

# Name of the httpOnly cookie that carries the session.
SESSION_COOKIE_NAME=orkestr_session

# How long a session stays valid (days).
SESSION_TTL_DAYS=30

# Set to true when the API is served over HTTPS (required in production).
SESSION_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# GitHub integration (required for real CI failure monitoring)
# ---------------------------------------------------------------------------
# Each account connects its own personal access token in
# Settings > GitHub Connection. The token below is only a fallback for
# projects without an owner or with an owner that has no connection.
#
# Personal Access Token with `repo` (private repos) and `read:packages` scope.
# A fine-grained token with "Actions: read" and "Metadata: read" is enough for
# public repositories. Without any token the monitor still reports application
# runtime errors, but it cannot reach the GitHub API.
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook payload URL. When set, every
# webhook delivery is verified with HMAC-SHA256 before it is processed.
GITHUB_WEBHOOK_SECRET=

# Optional overrides
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_OWNER=your-org

# ---------------------------------------------------------------------------
# Live monitoring behaviour
# ---------------------------------------------------------------------------
# Master switch for the background CI poller.
MONITORING_ENABLED=true

# How often the poller scans monitored repositories (milliseconds).
MONITORING_POLL_INTERVAL_MS=30000

# Lookback window used on the very first poll of a repository (minutes).
MONITORING_INITIAL_LOOKBACK_MINUTES=60

# Maximum workflow runs fetched per repository per cycle.
MONITORING_MAX_RUNS_PER_POLL=20

# Maximum bytes of a job log read before excerpting (the tail is preserved).
MONITORING_MAX_LOG_BYTES=1048576
