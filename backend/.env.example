# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your_secure_random_session_secret_change_in_production

# PostgreSQL Database Configuration
# Individual connection parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_project_manager
DB_USER=postgres
DB_PASSWORD=postgres

# Alternatively, specify a full connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_project_manager

# AI Provider Configuration (Google Gemini)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Integration (GitHub App)
# Create a GitHub App in GitHub Developer Settings:
# Settings -> Developer Settings -> GitHub Apps -> New GitHub App
# User authorization callback URL: http://localhost:5001/api/auth/github/callback
# Permissions: Account permissions -> Email addresses (Read-only)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5001/api/auth/github/callback
FRONTEND_URL=http://localhost:3000
