{
  "name": "ai-project-manager-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST API for AI-powered Project Manager",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "tsx test/test-verify.ts",
    "test:ai": "tsx test/test-ai-planner.ts",
    "test:distribute": "tsx test/test-task-distribution.ts",
    "test:auth": "tsx test/test-auth.ts",
    "test:authz": "tsx test/test-authorization.ts",
    "test:dashboard": "tsx test/test-personal-dashboard.ts",
    "test:usernames": "tsx test/test-registered-members-and-usernames.ts",
    "test:github": "tsx test/test-github-integration.ts",
    "test:webhooks": "tsx test/test-github-webhooks.ts",
    "test:activity": "tsx test/test-task-github-activities.ts",
    "test:task-numbers": "tsx test/test-task-numbering.ts",
    "test:verification": "tsx test/test-task-verification.ts",
    "test:lifecycle": "tsx test/test-task-lifecycle.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.19.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
